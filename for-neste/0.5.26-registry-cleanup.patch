+
+
+def test_legacy_diagnostic_cleanup_matches_historical_prefixes_only():
+    """Old Alpha prefixes must not keep retired entities in the registry."""
+    source = (COMPONENT / "__init__.py").read_text(encoding="utf-8")
+    setup = next(
+        node for node in ast.parse(source).body
+        if isinstance(node, ast.AsyncFunctionDef) and node.name == "async_setup_entry"
+    )
+    matcher = next(
+        node for node in setup.body
+        if isinstance(node, ast.FunctionDef) and node.name == "is_obsolete_unique_id"
+    )
+    names = {
+        "obsolete_unique_ids": {"AA:BB:CC:DD:EE:FF_raw_global_35"},
+        "obsolete_suffixes": (
+            "raw_global_35", "raw_global_5b", "experimental_write_probes",
+            "fan_probe_target_raw", "status_polling_interval",
+        ),
+    }
+    exec(compile(ast.Module(body=[matcher], type_ignores=[]), "<registry-matcher>", "exec"), names)
+    matches = names["is_obsolete_unique_id"]
+    assert matches("AA:BB:CC:DD:EE:FF_raw_global_35")
+    assert matches("AABBCCDDEEFF_diagnostic_raw_global_5b")
+    assert matches("other-prefix_fan_probe_target_raw")
+    assert matches("other-prefix_EXPERIMENTAL_WRITE_PROBES")
+    assert matches("status_polling_interval")
+    assert not matches("AA:BB:CC:DD:EE:FF_status_polling_active")
+    assert not matches("AA:BB:CC:DD:EE:FF_boost")
+    assert not matches("AA:BB:CC:DD:EE:FF_fan_speed")
