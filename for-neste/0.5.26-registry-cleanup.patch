+    def is_obsolete_unique_id(unique_id: str) -> bool:
+        """Match retired identifiers from earlier builds with varying prefixes.
+
+        Some Alpha builds used a diagnostic or normalized-address prefix rather
+        than the current ``address_suffix`` format. The registry lookup is
+        already restricted to this config entry, so matching an exact retired
+        suffix removes those historical aliases without touching live keys.
+        """
+        normalized = unique_id.casefold()
+        return unique_id in obsolete_unique_ids or any(
+            normalized == suffix or normalized.endswith(f"_{suffix}")
+            for suffix in obsolete_suffixes
+        )
