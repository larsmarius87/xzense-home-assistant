{
  "title": "Xzense Alpha",
  "config": {
    "step": {
      "user": {
        "title": "Choose Xzense",
        "description": "Choose a discovered Xzense device and enter the four-character PIN shown on the Xzense control panel.",
        "data": {
          "address": "Bluetooth address",
          "pin": "Xzense PIN"
        },
        "data_description": {
          "pin": "Four hexadecimal characters (0-9, A-F), for example B490."
        }
      },
      "bluetooth_confirm": {
        "title": "Set up Xzense Alpha",
        "description": "Enter the four-character PIN shown under Network → Bluetooth on the Xzense control panel.",
        "data": {
          "pin": "Xzense PIN"
        },
        "data_description": {
          "pin": "Four hexadecimal characters (0-9, A-F)."
        }
      },
      "reauth_confirm": {
        "title": "Enter Xzense PIN",
        "description": "This integration version requires the four-character PIN shown on the Xzense control panel.",
        "data": {
          "pin": "Xzense PIN"
        }
      },
      "reconfigure": {
        "title": "Change Xzense PIN",
        "description": "Update the PIN stored by Home Assistant.",
        "data": {
          "pin": "Xzense PIN"
        }
      }
    },
    "error": {
      "invalid_pin": "The PIN must contain exactly four hexadecimal characters (0-9, A-F)."
    },
    "abort": {
      "already_configured": "This Xzense device is already configured.",
      "no_devices_found": "No Xzense device was found.",
      "not_supported": "The discovered Bluetooth device is not supported.",
      "reauth_successful": "The Xzense PIN was updated.",
      "reconfigure_successful": "The Xzense PIN was updated."
    }
  },
